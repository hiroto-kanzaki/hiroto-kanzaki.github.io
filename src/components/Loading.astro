<script>
  const $ = (id: string) => document.getElementById(id);

  if (!sessionStorage.getItem("visited")) {
    sessionStorage.setItem("visited", "1");

    setTimeout(() => {
      $("loading-logo")?.classList.remove("opacity-0", "translate-y-3");
      $("loading-logo")?.classList.add("opacity-100", "translate-y-0");
    }, 200);

    setTimeout(() => {
      $("loading-logo")?.classList.remove("translate-y-0");
      $("loading-logo")?.classList.add("opacity-0", "-translate-y-4");

      $("loading")?.classList.add("opacity-0", "pointer-events-none");
    }, 2800);
  } else {
    $("loading")?.classList.add("hidden");
  }
</script>

<div
  id="loading"
  class="fixed inset-0 z-50 flex items-center bg-white transition-opacity duration-[1.5s] ease-in-out"
>
  <div class="w-full text-center">
    <span
      id="loading-logo"
      class="inline-block font-serif text-lg text-zinc-600 whitespace-nowrap opacity-0 translate-y-3 transition-all duration-[1.8s] ease-out"
    >
      hiroto kanzaki
    </span>
  </div>
</div>
